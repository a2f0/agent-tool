{
  "name": "@a2f0/agent-tool",
  "version": "0.1.6",
  "type": "module",
  "description": "Portable cross-agent review, PR workflows, and shared skills",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2f0/agent-tool.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-tool": "src/index.ts"
  },
  "files": [
    "src",
    "skills",
    "!src/**/*.test.ts",
    "!src/**/*.testUtils.ts"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "test": "bun test src scripts",
    "typecheck": "tsc --noEmit",
    "generate": "bun scripts/bundle-skills.ts",
    "build": "bun run generate && bun build --compile --minify src/index.ts --outfile dist/agent-tool"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  }
}
