{
  "name": "@a2f0/agent-tool",
  "version": "0.1.34",
  "packageManager": "bun@1.4.3",
  "type": "module",
  "description": "Portable cross-agent review, PR workflows, and shared skills",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2f0/agent-tool.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-tool": "src/index.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    "./screenshots/gallery": "./src/screenshots/gallery.ts",
    "./screenshots/gallery.css": "./src/screenshots/gallery.css",
    "./screenshots/manifest": "./src/screenshots/manifest.ts"
  },
  "files": [
    "src",
    "skills",
    "!src/**/*.test.ts",
    "!src/**/*.testUtils.ts"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "agent:run": "bun src/index.ts run",
    "agent:logs": "bun src/index.ts logs",
    "test": "bun test --parallel src scripts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "generate": "bun scripts/build/bundle-skills.ts",
    "build": "bun run generate && bun build --compile --minify src/index.ts --outfile dist/agent-tool"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.3",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  }
}
