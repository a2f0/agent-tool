{
  "label": "verify",
  "steps": [
    { "label": "typecheck", "command": ["bun", "run", "typecheck"] },
    { "label": "graph", "command": ["bun", "src/index.ts", "graph", "check"] },
    { "label": "tests", "command": ["bun", "test", "--parallel"] },
    { "label": "package-smoke", "command": ["bun", "scripts/testing/smoke-package.ts"] },
    { "label": "build", "command": ["bun", "run", "build"] },
    { "label": "compiled-smoke", "command": ["bun", "scripts/testing/smoke.ts", "dist/agent-tool"] }
  ]
}
